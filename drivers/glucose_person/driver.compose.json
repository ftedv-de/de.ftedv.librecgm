{
  "id": "glucose_person",
  "name": {
    "en": "LibreView Patient",
    "de": "LibreView Patient"
  },
  "class": "sensor",
  "capabilities": [
    "measure_glucose_mgdl",
    "measure_glucose_mmol",
    "measure_glucose_delta_mgdl",
    "measure_glucose_delta_mmol",
    "glucose_trend",
    "sensor_expiry_hours",
    "alarm_glucose_high",
    "alarm_glucose_low",
    "alarm_sensor_expiry",
    "sensor_serial_number"
  ],
  "capabilitiesOptions": {
    "measure_glucose_mgdl": {
      "preventInsights": false
    },
    "measure_glucose_mmol": {
      "preventInsights": false
    },
    "measure_glucose_delta_mgdl": {
      "preventInsights": true
    },
    "measure_glucose_delta_mmol": {
      "preventInsights": true
    },
    "sensor_expiry_hours": {
      "preventInsights": true
    },
    "sensor_serial_number": {
      "preventInsights": true
    }
  },
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png"    
  },
  "settings": [
    {
      "id": "glucose_unit",
      "type": "dropdown",
      "label": {
        "en": "Preferred glucose unit",
        "de": "Bevorzugte Glukoseeinheit"
      },
      "value": "account",
      "values": [
        {
          "id": "account",
          "label": {
            "en": "Use LibreView account unit",
            "de": "LibreView-Kontoeinheit verwenden"
          }
        },
        {
          "id": "mgdl",
          "label": {
            "en": "mg/dL",
            "de": "mg/dL"
          }
        },
        {
          "id": "mmol",
          "label": {
            "en": "mmol/L",
            "de": "mmol/L"
          }
        }
      ]
    },
    {
      "id": "target_range_source",
      "type": "dropdown",
      "label": {
        "en": "Target range",
        "de": "Zielbereich"
      },
      "value": "account",
      "values": [
        {
          "id": "account",
          "label": {
            "en": "Use LibreView target range",
            "de": "LibreView-Zielbereich verwenden"
          }
        },
        {
          "id": "custom",
          "label": {
            "en": "Use custom target range",
            "de": "Eigenen Zielbereich verwenden"
          }
        }
      ]
    },
    {
      "id": "target_low_mgdl",
      "type": "number",
      "label": {
        "en": "Custom low limit (mg/dL)",
        "de": "Eigene Untergrenze (mg/dL)"
      },
      "value": 70,
      "min": 40,
      "max": 499
    },
    {
      "id": "target_high_mgdl",
      "type": "number",
      "label": {
        "en": "Custom high limit (mg/dL)",
        "de": "Eigene Obergrenze (mg/dL)"
      },
      "value": 180,
      "min": 41,
      "max": 500
    },
    {
      "id": "sensor_lifetime_days",
      "type": "number",
      "label": {
        "en": "Sensor lifetime in days",
        "de": "Sensorlaufzeit in Tagen"
      },
      "value": 15,
      "min": 1,
      "max": 30
    }
  ],
  "pair": [
    {
      "id": "login",
      "navigation": {
        "next": "list_devices"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
