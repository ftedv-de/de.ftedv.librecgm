{
  "name": {
    "en": "Glucose history",
    "de": "Glukoseverlauf"
  },
  "description": {
    "en": "Shows the glucose history of the last 24 hours.",
    "de": "Zeigt den Glukoseverlauf der letzten 24 Stunden."
  },
  "height": "64",
  "devices": {
    "type": "global",
    "singular": true,
    "filter": {
      "capabilities": "measure_glucose_mgdl"
    }
  },
  "api": {
    "getGlucoseHistory": {
      "method": "GET",
      "path": "/getGlucoseHistory"
    }
  },
  "settings": [
    {
      "id": "glucose_unit",
      "type": "dropdown",
      "title": {
        "en": "Glucose unit",
        "de": "Glukoseeinheit"
      },
      "value": "mgdl",
      "values": [
        {
          "id": "mgdl",
          "label": {
            "en": "mg/dL",
            "de": "mg/dL"
          }
        },
        {
          "id": "mmol",
          "label": {
            "en": "mmol/L",
            "de": "mmol/L"
          }
        }
      ]
    },
    {
      "id": "smooth_chart",
      "type": "checkbox",
      "title": {
        "en": "Smooth chart line",
        "de": "Kurve glätten"
      },
      "value": true
    },
    {
      "id": "history_range_hours",
      "type": "dropdown",
      "title": {
        "en": "History range",
        "de": "Zeitraum"
      },
      "value": "24",
      "values": [
        {
          "id": "6",
          "label": {
            "en": "6 hours",
            "de": "6 Stunden"
          }
        },
        {
          "id": "12",
          "label": {
            "en": "12 hours",
            "de": "12 Stunden"
          }
        },
        {
          "id": "24",
          "label": {
            "en": "24 hours",
            "de": "24 Stunden"
          }
        }
      ]
    }
  ]
}